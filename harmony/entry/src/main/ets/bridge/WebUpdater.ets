import { common } from '@kit.AbilityKit';
import { webview } from '@kit.ArkWeb';
import { util } from '@kit.ArkTS';
import { cryptoFramework } from '@kit.CryptoArchitectureKit';
import { fileIo as fs } from '@kit.CoreFileKit';
import { resourceManager } from '@kit.LocalizationKit';
import { http } from '@kit.NetworkKit';

// Updates the bundled web frontend without a new app package. The server
// publishes web-manifest.json (generated by vite.config.js) next to the files
// it already hosts; a newer version is assembled under filesDir — unchanged
// files copied locally, the rest downloaded and checked against their SHA-256 —
// and served by the app:// scheme handler.
//
// The server URL lives in the page's localStorage, so the page hands it over
// through check() and it is persisted here. On the next cold start prepare()
// checks that server before the first page load and waits up to UPDATE_WAIT_MS,
// so an update takes effect on that same launch. A slower download finishes in
// the background and is served from the following cold start.
//
// The frontend calls ready() once it has booted. A version that never reports
// ready within READY_TIMEOUT_MS is marked bad and the previous one is restored.
// Installing a new app package discards every download, so its rawfile wins.

// Bump together with HARMONY_NATIVE_API in vite.config.js whenever the frontend
// starts relying on native code older shells lack; they then keep their bundle.
export const NATIVE_API: number = 2;

const MANIFEST: string = 'web-manifest.json';
const ROOT: string = 'web-update';
const STATE: string = 'state.json';
const READY_TIMEOUT_MS: number = 15000;
const UPDATE_WAIT_MS: number = 8000;
const PARALLEL: number = 4;
const MAX_BAD: number = 20;

// Classes, not interfaces: ArkTS only casts parsed JSON onto a declared class.
class ManifestFile {
  path: string = '';
  sha256: string = '';
  size: number = 0;
}

class Manifest {
  version: string = '';
  nativeApi: number = 0;
  files: ManifestFile[] = [];
}

class UpdateState {
  server: string = '';    // signed-in server, reported by the page
  builtin: string = '';   // rawfile version these downloads were made against
  current: string = '';   // downloaded version being served; '' = rawfile
  previous: string = '';
  ready: string = '';     // downloaded, not applied yet
  trial: string = '';     // applied, waiting for ready()
  bad: string[] = [];
}

class CheckArgs {
  server: string = '';
}

const VERSION_RE: RegExp = /^[0-9a-f]{16}$/;
const PATH_RE: RegExp = /^[A-Za-z0-9._@~+-]+(\/[A-Za-z0-9._@~+-]+)*$/;

function safePath(path: string): boolean {
  return PATH_RE.test(path) && !path.split('/').some((segment: string) => segment === '..' || segment === '.');
}

function parseManifest(text: string): Manifest | null {
  try {
    const manifest: Manifest = JSON.parse(text) as Manifest;
    if (!VERSION_RE.test(`${manifest.version}`) || !Array.isArray(manifest.files)) {
      return null;
    }
    for (const file of manifest.files) {
      if (!safePath(`${file.path}`) || !/^[0-9a-f]{64}$/.test(`${file.sha256}`)) {
        return null;
      }
    }
    return manifest;
  } catch (e) {
    return null;
  }
}

function sha256Hex(data: Uint8Array): string {
  const md: cryptoFramework.Md = cryptoFramework.createMd('SHA256');
  const chunk: number = 64 * 1024;
  for (let offset: number = 0; offset < data.length; offset += chunk) {
    md.updateSync({ data: data.subarray(offset, Math.min(data.length, offset + chunk)) });
  }
  const digest: Uint8Array = md.digestSync().data;
  let hex: string = '';
  for (let i: number = 0; i < digest.length; i++) {
    hex += (digest[i] < 16 ? '0' : '') + digest[i].toString(16);
  }
  return hex;
}

function decode(data: Uint8Array): string {
  return util.TextDecoder.create('utf-8').decodeToString(data);
}

function exists(path: string): boolean {
  try {
    return fs.accessSync(path);
  } catch (e) {
    return false;
  }
}

function readFile(path: string): Uint8Array {
  const file: fs.File = fs.openSync(path, fs.OpenMode.READ_ONLY);
  try {
    const size: number = fs.statSync(file.fd).size;
    const buffer: ArrayBuffer = new ArrayBuffer(size);
    if (size > 0 && fs.readSync(file.fd, buffer) !== size) {
      throw new Error(`short read: ${path}`);
    }
    return new Uint8Array(buffer);
  } finally {
    fs.closeSync(file);
  }
}

function writeFile(path: string, data: Uint8Array): void {
  const file: fs.File = fs.openSync(path, fs.OpenMode.CREATE | fs.OpenMode.TRUNC | fs.OpenMode.WRITE_ONLY);
  try {
    const buffer: ArrayBuffer = data.buffer.slice(data.byteOffset, data.byteOffset + data.byteLength) as ArrayBuffer;
    if (data.byteLength > 0 && fs.writeSync(file.fd, buffer) !== data.byteLength) {
      throw new Error(`short write: ${path}`);
    }
  } finally {
    fs.closeSync(file);
  }
}

function makeDir(path: string): void {
  if (!exists(path)) {
    fs.mkdirSync(path, true);
  }
}

function removeTree(path: string): void {
  try {
    if (!exists(path)) {
      return;
    }
    if (fs.statSync(path).isDirectory()) {
      fs.rmdirSync(path);
    } else {
      fs.unlinkSync(path);
    }
  } catch (e) {
    console.error(`baton web update: cannot remove ${path}`);
  }
}

// https, a host, and no user:password — the same rule as the download bridge.
function isHttpsUrl(url: string): boolean {
  const match: RegExpMatchArray | null = url.match(/^https:\/\/([^/?#]+)/);
  return match !== null && !match[1].includes('@');
}

async function fetchBytes(url: string): Promise<Uint8Array> {
  const request: http.HttpRequest = http.createHttp();
  try {
    const response: http.HttpResponse = await request.request(url, {
      method: http.RequestMethod.GET,
      expectDataType: http.HttpDataType.ARRAY_BUFFER,
      // Bytes are hashed exactly as received, so ask for them uncompressed.
      header: { 'Accept-Encoding': 'identity', 'Cache-Control': 'no-cache' },
      connectTimeout: 15000,
      readTimeout: 30000
    });
    if (response.responseCode !== 200) {
      throw new Error(`HTTP ${response.responseCode}: ${url}`);
    }
    return new Uint8Array(response.result as ArrayBuffer);
  } finally {
    request.destroy();
  }
}

export class WebUpdater {
  controller: webview.WebviewController | null = null;
  private resMgr: resourceManager.ResourceManager | null = null;
  private root: string = '';
  private state: UpdateState = new UpdateState();
  private builtin: Manifest | null = null;
  // Fixed for the lifetime of a page load, so lazily imported chunks always
  // come from the version that served the page.
  private activeDir: string = '';
  private active: Manifest | null = null;
  private checked: boolean = false;
  private readyTimer: number = -1;

  init(context: common.Context, controller: webview.WebviewController): void {
    this.controller = controller;
    this.resMgr = context.resourceManager;
    this.root = `${context.filesDir}/${ROOT}`;
    try {
      makeDir(this.root);
      this.builtin = this.readBuiltinManifest();
      const builtinVersion: string = this.builtin !== null ? this.builtin.version : '';
      this.state = this.loadState();
      if (this.state.builtin !== builtinVersion) {
        const server: string = this.state.server;
        this.state = new UpdateState();
        this.state.server = server;
        this.state.builtin = builtinVersion;
      }
      if (this.state.ready.length > 0 && this.state.ready !== this.state.current) {
        this.promote(this.state.ready);
      }
      if (this.state.previous.length > 0 && this.readManifest(this.state.previous) === null) {
        this.state.previous = '';
      }
      this.activate();
      this.saveState();
      this.prune();
      if (this.state.trial.length > 0) {
        this.armReadyTimer();
      }
    } catch (e) {
      console.error(`baton web update init failed: ${JSON.stringify(e)}`);
      this.activeDir = '';
      this.active = this.builtin;
    }
  }

  release(): void {
    this.clearReadyTimer();
    this.controller = null;
  }

  // Serves app://local/<path>; throws when the file is not in the active bundle.
  read(path: string): Uint8Array {
    if (this.activeDir.length === 0) {
      return this.resMgr!.getRawFileContentSync(path);
    }
    if (!safePath(path)) {
      throw new Error(`invalid path: ${path}`);
    }
    return readFile(`${this.activeDir}/${path}`);
  }

  ready(): void {
    this.clearReadyTimer();
    if (this.state.trial.length > 0 && this.state.trial === this.state.current) {
      this.state.trial = '';
      this.saveState();
    }
  }

  // Runs before the first page load. Resolves once the page may load: an
  // update that finished in time is already active, anything else continues in
  // the background and never swaps files under the running page.
  async prepare(): Promise<void> {
    if (this.state.server.length === 0 || this.state.ready.length > 0) {
      return;
    }
    this.checked = true;
    let timer: number = -1;
    const timeout: Promise<void> = new Promise<void>((resolve: () => void) => {
      timer = setTimeout(resolve, UPDATE_WAIT_MS);
    });
    await Promise.race([this.runUpdate(this.state.server), timeout]);
    clearTimeout(timer);
    if (this.state.ready.length > 0) {
      this.promote(this.state.ready);
      this.activate();
      this.saveState();
      this.armReadyTimer();
    }
  }

  // Called by every page: remembers the server for the next prepare(), and
  // checks it in the background when this launch had none to check before.
  check(argsJson: string): void {
    let server: string = '';
    try {
      server = `${(JSON.parse(argsJson) as CheckArgs).server}`.replace(/\/+$/, '');
    } catch (e) {
      return;
    }
    if (!isHttpsUrl(server)) {
      return;
    }
    if (server !== this.state.server) {
      this.state.server = server;
      this.saveState();
    }
    if (this.checked || this.state.ready.length > 0) {
      return;
    }
    this.checked = true;
    this.runUpdate(server);
  }

  private runUpdate(server: string): Promise<void> {
    return this.update(server)
      .catch((e: Error) => console.error(`baton web update failed: ${e.message}`));
  }

  private async update(server: string): Promise<void> {
    const manifest: Manifest | null = parseManifest(decode(await fetchBytes(`${server}/${MANIFEST}?ts=${Date.now()}`)));
    if (manifest === null || manifest.nativeApi > NATIVE_API) {
      return;
    }
    const version: string = manifest.version;
    const activeVersion: string = this.active !== null ? this.active.version : '';
    if (version === activeVersion || this.state.bad.includes(version)) {
      return;
    }
    if (version !== this.state.previous || this.readManifest(version) === null) {
      await this.assemble(server, manifest);
    }
    this.state.ready = version;
    this.saveState();
  }

  // Builds the version in a temp dir and renames it into place only when every
  // file matched its hash, so a half-written version is never served.
  private async assemble(server: string, manifest: Manifest): Promise<void> {
    const temp: string = `${this.root}/tmp-${manifest.version}`;
    removeTree(temp);
    makeDir(temp);
    const local: Map<string, string> = new Map<string, string>();
    const remember = (source: Manifest | null, dir: string): void => {
      if (source === null) {
        return;
      }
      for (const file of source.files) {
        if (!local.has(`${file.path}\n${file.sha256}`)) {
          local.set(`${file.path}\n${file.sha256}`, dir);
        }
      }
    };
    remember(this.active, this.activeDir);
    remember(this.builtin, '');
    let next: number = 0;
    const worker = async (): Promise<void> => {
      while (next < manifest.files.length) {
        const file: ManifestFile = manifest.files[next++];
        const source: string | undefined = local.get(`${file.path}\n${file.sha256}`);
        let data: Uint8Array | null = null;
        if (source !== undefined) {
          try {
            data = source.length > 0 ? readFile(`${source}/${file.path}`) : this.resMgr!.getRawFileContentSync(file.path);
          } catch (e) {
            data = null;
          }
        }
        if (data === null || sha256Hex(data) !== file.sha256) {
          const url: string = `${server}/${file.path.split('/').map((s: string) => encodeURIComponent(s)).join('/')}`;
          data = await fetchBytes(url);
          if (sha256Hex(data) !== file.sha256) {
            throw new Error(`hash mismatch: ${file.path}`);
          }
        }
        const slash: number = file.path.lastIndexOf('/');
        if (slash > 0) {
          makeDir(`${temp}/${file.path.substring(0, slash)}`);
        }
        writeFile(`${temp}/${file.path}`, data);
      }
    };
    try {
      const workers: Promise<void>[] = [];
      for (let i: number = 0; i < PARALLEL; i++) {
        workers.push(worker());
      }
      await Promise.all(workers);
      writeFile(`${temp}/${MANIFEST}`, new util.TextEncoder().encodeInto(JSON.stringify(manifest)));
      const target: string = this.dirOf(manifest.version);
      removeTree(target);
      fs.renameSync(temp, target);
    } catch (e) {
      removeTree(temp);
      throw e as Error;
    }
  }

  private promote(version: string): void {
    this.state.previous = this.state.current;
    this.state.current = version;
    this.state.ready = '';
    this.state.trial = version;
  }

  private activate(): void {
    const manifest: Manifest | null = this.state.current.length > 0 ? this.readManifest(this.state.current) : null;
    if (manifest === null) {
      this.state.current = '';
      this.state.trial = '';
      this.activeDir = '';
      this.active = this.builtin;
      return;
    }
    this.activeDir = this.dirOf(this.state.current);
    this.active = manifest;
  }

  private rollback(): void {
    const failed: string = this.state.trial;
    if (failed.length === 0 || failed !== this.state.current) {
      return;
    }
    console.error(`baton web update: ${failed} did not boot, rolling back`);
    this.state.bad = this.state.bad.filter((v: string) => v !== failed).concat([failed]).slice(-MAX_BAD);
    this.state.current = this.state.previous;
    this.state.previous = '';
    this.state.trial = '';
    this.activate();
    this.saveState();
    removeTree(this.dirOf(failed));
    this.controller?.refresh();
  }

  private armReadyTimer(): void {
    this.clearReadyTimer();
    this.readyTimer = setTimeout(() => {
      this.readyTimer = -1;
      this.rollback();
    }, READY_TIMEOUT_MS);
  }

  private clearReadyTimer(): void {
    if (this.readyTimer !== -1) {
      clearTimeout(this.readyTimer);
      this.readyTimer = -1;
    }
  }

  private dirOf(version: string): string {
    return `${this.root}/v-${version}`;
  }

  private readManifest(version: string): Manifest | null {
    try {
      const manifest: Manifest | null = parseManifest(decode(readFile(`${this.dirOf(version)}/${MANIFEST}`)));
      return manifest !== null && manifest.version === version ? manifest : null;
    } catch (e) {
      return null;
    }
  }

  private readBuiltinManifest(): Manifest | null {
    try {
      return parseManifest(decode(this.resMgr!.getRawFileContentSync(MANIFEST)));
    } catch (e) {
      return null;
    }
  }

  private loadState(): UpdateState {
    const state: UpdateState = new UpdateState();
    try {
      const saved: UpdateState = JSON.parse(decode(readFile(`${this.root}/${STATE}`))) as UpdateState;
      const pick = (value: string): string => VERSION_RE.test(`${value}`) ? value : '';
      state.server = typeof saved.server === 'string' && isHttpsUrl(saved.server) ? saved.server : '';
      state.builtin = typeof saved.builtin === 'string' ? saved.builtin : '';
      state.current = pick(saved.current);
      state.previous = pick(saved.previous);
      state.ready = pick(saved.ready);
      state.trial = pick(saved.trial);
      state.bad = Array.isArray(saved.bad) ? saved.bad.filter((v: string) => VERSION_RE.test(`${v}`)) : [];
    } catch (e) {
      // First launch, or an unreadable file: start from the bundled frontend.
    }
    return state;
  }

  private saveState(): void {
    try {
      const temp: string = `${this.root}/${STATE}.tmp`;
      writeFile(temp, new util.TextEncoder().encodeInto(JSON.stringify(this.state)));
      fs.renameSync(temp, `${this.root}/${STATE}`);
    } catch (e) {
      console.error(`baton web update: cannot save state`);
    }
  }

  // Keeps only the versions the state still points at.
  private prune(): void {
    const keep: Set<string> = new Set<string>([STATE]);
    for (const version of [this.state.current, this.state.previous, this.state.ready]) {
      if (version.length > 0) {
        keep.add(`v-${version}`);
      }
    }
    for (const name of fs.listFileSync(this.root)) {
      if (!keep.has(name)) {
        removeTree(`${this.root}/${name}`);
      }
    }
  }
}
